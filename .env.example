# ── Supabase（顧客管理CRM） ──────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── メール通知 ───────────────────────────────────────────────
ADMIN_NOTIFICATION_EMAIL=admin@yourdomain.com
# adofy管理画面(/adofy-admin)を開けるメールアドレス（カンマ区切り）
# 高長建設の/adminには提携業者もログインするため、adofy側はここで明示的に絞る
ADOFY_ADMIN_EMAILS=you@example.com

# adofy 無料相談フォームの通知先（未設定なら NOTIFICATION_EMAIL を使う）
ADOFY_NOTIFICATION_EMAIL=admin@yourdomain.com
# 送信元アドレス（未設定なら Resend の検証用アドレスを使う）
RESEND_FROM_EMAIL=noreply@yourdomain.com
MAIL_FROM_ADDRESS=noreply@yourdomain.com

# ── Web Push（プッシュ通知） ──────────────────────────────────
# VAPIDキー生成: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@yourdomain.com

# ── Cron 保護シークレット ─────────────────────────────────────
# 生成例: openssl rand -hex 32
CRON_SECRET=your-cron-secret

# ── AI外構シミュレーター ────────────────────────────────────
OPENAI_API_KEY=sk-proj-...

# ── 外壁塗装 ────────────────────────────────────────────────
OPENAI_IMAGE_MODEL=gpt-image-2
RESEND_API_KEY=re_...
NOTIFICATION_EMAIL=admin@yourdomain.com
# adofy管理画面(/adofy-admin)を開けるメールアドレス（カンマ区切り）
# 高長建設の/adminには提携業者もログインするため、adofy側はここで明示的に絞る
ADOFY_ADMIN_EMAILS=you@example.com

# adofy 無料相談フォームの通知先（未設定なら NOTIFICATION_EMAIL を使う）
ADOFY_NOTIFICATION_EMAIL=admin@yourdomain.com
# 送信元アドレス（未設定なら Resend の検証用アドレスを使う）
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ── 開発用認証バイパス ───────────────────────────────────────
# ⚠️ Production では絶対に true にしないこと
# ローカル (NODE_ENV=development) または Vercel Preview でのみ有効
# VERCEL_ENV=production の場合は設定値に関わらず認証は必須
AUTH_BYPASS_ENABLED=true
NEXT_PUBLIC_AUTH_BYPASS_ENABLED=true
DEMO_DATA_ENABLED=true
NEXT_PUBLIC_DEMO_DATA_ENABLED=true

# ── ドラテク 企業向けLP（driver.taxidriver-beginner.com/company） ──────
# 掲載相談の通知先（未設定なら NOTIFICATION_EMAIL → ADMIN_NOTIFICATION_EMAIL の順に使う）
DORATECH_NOTIFICATION_EMAIL=admin@yourdomain.com
#
# 事業者情報。値が入っている項目だけがLPに表示される。
# 確定していない項目は空のままにすること（未確定の情報を出さないため）。
NEXT_PUBLIC_DORATECH_OPERATOR_NAME=
NEXT_PUBLIC_DORATECH_TRADE_NAME=
NEXT_PUBLIC_DORATECH_ADDRESS=
# 電話番号・メールアドレスを設定すると、LPに電話/メールのCTAが表示される
NEXT_PUBLIC_DORATECH_PHONE=
NEXT_PUBLIC_DORATECH_EMAIL=
# 特定募集情報等提供事業届出受理番号（例: 51-募-000000）
# ⚠️ 届出が受理されるまでは絶対に値を入れないこと。空の間はフッターの行ごと非表示になる
NEXT_PUBLIC_DORATECH_NOTICE_NUMBER=
# プライバシーポリシーのURL（未設定ならフォーム内に個人情報の取扱いを直接表示する）
NEXT_PUBLIC_DORATECH_PRIVACY_URL=

# 採用レスキューLP（/saiyo-rescue）無料相談の通知先（未設定なら NOTIFICATION_EMAIL を使う）
SAIYO_RESCUE_NOTIFICATION_EMAIL=admin@yourdomain.com

# ── ドラテク 営業メール（/admin/outreach → /adofy-admin/outreach） ─────────
# 送信は既存の Resend（RESEND_API_KEY）を使う。個人Gmail の SMTP は使わない。
# 送信元は営業メール専用のサブドメインを Resend で認証して使うこと（例: info@mail.example.jp）
OUTREACH_FROM_EMAIL="ドラテク <info@mail.example.jp>"
# 返信先（未設定なら管理画面の「連絡先メールアドレス」）
OUTREACH_REPLY_TO=
# メール配信サービスの上限。管理画面の送信速度はこれを超えられない（Resend 無料プランは1日100通）
OUTREACH_PROVIDER_MAX_PER_MINUTE=60
OUTREACH_PROVIDER_MAX_PER_HOUR=1000
OUTREACH_PROVIDER_MAX_PER_DAY=100
# Resend Webhook の署名シークレット（whsec_...）。配信成功・バウンス・苦情・返信の記録に使う
RESEND_WEBHOOK_SECRET=
# メール内リンク（クリック計測・配信停止）の公開URL。未設定なら https://driver.taxidriver-beginner.com
OUTREACH_PUBLIC_BASE_URL=
# 営業メールのリンク先LPの既定値。未設定なら https://driver.taxidriver-beginner.com/company
OUTREACH_LANDING_URL=
# 営業先の自動取得（どちらか一方でも可）
#   gBizINFO: https://info.gbiz.go.jp/ でアカウント登録 → APIトークン
#   Google Places API (New): Google Cloud で Places API を有効化したキー
GBIZINFO_API_TOKEN=
GOOGLE_PLACES_API_KEY=
# AIで文章を作成（既存の OPENAI_API_KEY を使う）
OUTREACH_AI_MODEL=gpt-5-mini
# /api/cron/outreach を呼ぶときの Bearer トークン（既存の CRON_SECRET と共通）
