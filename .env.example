# ── Supabase（顧客管理CRM） ──────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── メール通知 ───────────────────────────────────────────────
ADMIN_NOTIFICATION_EMAIL=admin@yourdomain.com
# adofy管理画面(/adofy-admin)を開けるメールアドレス（カンマ区切り）
# 高長建設の/adminには提携業者もログインするため、adofy側はここで明示的に絞る
ADOFY_ADMIN_EMAILS=you@example.com

# adofy 無料相談フォームの通知先（未設定なら NOTIFICATION_EMAIL を使う）
ADOFY_NOTIFICATION_EMAIL=admin@yourdomain.com
# 送信元アドレス（未設定なら Resend の検証用アドレスを使う）
RESEND_FROM_EMAIL=noreply@yourdomain.com
MAIL_FROM_ADDRESS=noreply@yourdomain.com

# ── Web Push（プッシュ通知） ──────────────────────────────────
# VAPIDキー生成: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@yourdomain.com

# ── Cron 保護シークレット ─────────────────────────────────────
# 生成例: openssl rand -hex 32
CRON_SECRET=your-cron-secret

# ── AI外構シミュレーター ────────────────────────────────────
OPENAI_API_KEY=sk-proj-...

# ── 外壁塗装 ────────────────────────────────────────────────
OPENAI_IMAGE_MODEL=gpt-image-2
RESEND_API_KEY=re_...
NOTIFICATION_EMAIL=admin@yourdomain.com
# adofy管理画面(/adofy-admin)を開けるメールアドレス（カンマ区切り）
# 高長建設の/adminには提携業者もログインするため、adofy側はここで明示的に絞る
ADOFY_ADMIN_EMAILS=you@example.com

# adofy 無料相談フォームの通知先（未設定なら NOTIFICATION_EMAIL を使う）
ADOFY_NOTIFICATION_EMAIL=admin@yourdomain.com
# 送信元アドレス（未設定なら Resend の検証用アドレスを使う）
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ── 開発用認証バイパス ───────────────────────────────────────
# ⚠️ Production では絶対に true にしないこと
# ローカル (NODE_ENV=development) または Vercel Preview でのみ有効
# VERCEL_ENV=production の場合は設定値に関わらず認証は必須
AUTH_BYPASS_ENABLED=true
NEXT_PUBLIC_AUTH_BYPASS_ENABLED=true
DEMO_DATA_ENABLED=true
NEXT_PUBLIC_DEMO_DATA_ENABLED=true
